# Copy to .env on the server (cp .env.example .env) and fill in.
# Never commit .env. Generate secrets with: openssl rand -hex 32

N8N_HOST=n8n.noahhofmann.com

POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me-openssl-rand-hex-32
POSTGRES_DB=n8n

# Encrypts all credentials stored in n8n. Keep a copy in your password manager:
# losing it means re-entering every credential after a restore.
N8N_ENCRYPTION_KEY=change-me-openssl-rand-hex-32

# From Cloudflare Zero Trust > Networks > Tunnels > your tunnel > install command
CLOUDFLARE_TUNNEL_TOKEN=paste-token-here
