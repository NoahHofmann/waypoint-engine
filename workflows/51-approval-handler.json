      "id": "89bec65b-c774-4f77-ab72-986bb52bbc8e",
      "name": "Notion approval as tap",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        620
      ],
      "parameters": {
        "jsCode": "// Turn a Notion approval into the same shape as a Telegram tap, so ONE code path decides.\nconst k = String($json.contactPageId || '').replace(/-/g, '');\nconst c = String($json.choice || '');\nconst data = c === 'Skip' ? 's|' + k : 'v|' + k + '|' + c;\nreturn { json: { fromNotion: true, callback_query: { id: 'notion', data, message: { message_id: $json.cardMessageId ? Number($json.cardMessageId) : null, chat: { id: 1170608781 }, text: '' } } } };",
        "mode": "runOnceForEachItem"
      }
    },
    {
      "id": "dd6eea0f-f345-4389-a352-8ab18e10e571",
      "name": "Telegram trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "updates": [
          "callback_query",
          "message"
        ],
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": {
          "id": "x17tu5yr5xFWMSsZ",
          "name": "Telegram approvals"
        }
      },
      "webhookId": "d42d2378-3b2b-4a74-bcc0-d118fecd3f0e"
    },
    {
      "id": "4851c34b-f0e6-4534-8dc8-28058802b472",
      "name": "Parse update (rules)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "// Parse the Telegram update (rules). Only Noah's chat is accepted; everything else is ignored silently (security).\n// Every message FROM Noah gets an answer: tap, reply to a card, reply to a 🌐 question, or a help note ('unmatched').\nconst u = $json; const ALLOWED = '1170608781';\nconst cb = u.callback_query; const msg = u.message;\nconst chatId = String(cb?.message?.chat?.id ?? msg?.chat?.id ?? '');\nconst uuidOf = key => key ? key.replace(/(.{8})(.{4})(.{4})(.{4})(.{12})/, '$1-$2-$3-$4-$5') : null;\nconst titleOf = t => String(t || '').split('\\n')[0].replace(/^📨 APPROVE \\d+\\/\\d+ · /, '').replace(/^🌐 WEBSITE\\? · /, '');\nif (chatId !== ALLOWED) return { json: { ok: false, kind: 'ignore', reason: 'unauthorized chat ' + chatId } };\nif (cb) {\n  const [k, key, v] = String(cb.data || '').split('|');\n  const kind = k === 'v' ? 'choose' : k === 'e' ? 'edit' : k === 's' ? 'skip' : k === 'w' ? 'website_none' : 'unmatched';\n  return { json: { ok: true, fromNotion: !!u.fromNotion, kind, variant: v || null,\n    contactPageId: k === 'w' ? null : uuidOf(key), companyPageId: k === 'w' ? uuidOf(key) : null,\n    callbackId: cb.id, cardMessageId: cb.message?.message_id ?? null, cardTitle: titleOf(cb.message?.text), chatId } };\n}\nconst replyTo = msg?.reply_to_message;\nconst ref = String(replyTo?.text || '').match(/ref w\\|([0-9a-f]{32})/);\nif (msg && ref && msg.text) {\n  const dom = String(msg.text).trim().toLowerCase().replace(/^https?:\\/\\//, '').replace(/^www\\./, '').split(/[\\/\\s]/)[0];\n  const okDom = /^[a-z0-9-]+(\\.[a-z0-9-]+)*\\.[a-z]{2,}$/.test(dom);\n  return { json: { ok: true, kind: okDom ? 'website' : 'website_bad', domain: dom, companyPageId: uuidOf(ref[1]),\n    cardMessageId: replyTo.message_id, replyMessageId: msg.message_id, cardTitle: titleOf(replyTo.text), chatId } };\n}\nif (msg && replyTo && msg.text) {\n  return { json: { ok: true, kind: 'reply', text: msg.text, cardMessageId: replyTo.message_id, replyMessageId: msg.message_id, cardTitle: titleOf(replyTo.text), chatId } };\n}\nreturn { json: { ok: true, kind: 'unmatched', replyMessageId: msg?.message_id ?? null, chatId } };",
        "mode": "runOnceForEachItem"
      }
    },
