    {
      "id": "cf6939d7-5763-4802-ad34-d90dc4b4ea01",
      "name": "Build website update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        560
      ],
      "parameters": {
        "jsCode": "const h = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n// Website answer from Noah -> what to write to the company + how to close the 🌐 question.\nconst p = $('Parse update (rules)').item.json;\nconst co = h(p.cardTitle || 'Company');\nif (p.kind === 'website_bad') return { json: { ...p, valid: false,\n  notice: `⚠️ <b>\"${h(p.domain)}\" doesn't look like a domain.</b>\\nReply to the 🌐 question again, e.g. <code>acme.ai</code>` } };\nconst props = p.kind === 'website'\n  ? { 'Domain': { url: 'https://' + p.domain }, 'Domain source': { select: { name: 'Manual' } } }\n  : { 'Domain source': { select: { name: 'No website' } } };\nreturn { json: { ...p, valid: true, notionBody: { properties: props },\n  closeText: p.kind === 'website'\n    ? `✅ <b>WEBSITE SAVED · ${co}</b>\\n${h(p.domain)} · its contacts go back to email search on the next run.`\n    : `🚫 <b>NO WEBSITE · ${co}</b>\\nContacts stay LinkedIn-only.` } };",
        "mode": "runOnceForEachItem"
      }
    },
