      "name": "Notion approval as tap",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        520
      ],
      "parameters": {
        "jsCode": "// Turn a Notion approval into the same shape as a Telegram tap, so ONE code path decides.\nconst k = String($json.contactPageId || '').replace(/-/g, '');\nconst c = String($json.choice || '');\nconst data = c === 'Skip' ? 's|' + k : 'v|' + k + '|' + c;\nreturn { json: { fromNotion: true, callback_query: { id: 'notion', data, message: { message_id: $json.cardMessageId ? Number($json.cardMessageId) : null, chat: { id: 1170608781 } } } } };",
        "mode": "runOnceForEachItem"
      }
    },
    {
      "id": "b944761d-2d66-4cf7-a73c-19d183271377",
      "name": "Telegram trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "updates": [
          "callback_query",
          "message"
        ],
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": {
          "id": "x17tu5yr5xFWMSsZ",
          "name": "Telegram approvals"
        }
      },
      "webhookId": "5484d8f9-40be-48fc-85a6-e66141fd9687"
