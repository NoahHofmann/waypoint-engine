      "id": "8e529a9c-d6e3-4830-b8ac-04fa07fca178",
      "name": "Notion approval as tap",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        520
      ],
      "parameters": {
        "jsCode": "// Turn a Notion approval into the same shape as a Telegram tap, so ONE code path decides.\nconst k = String($json.contactPageId || '').replace(/-/g, '');\nconst c = String($json.choice || '');\nconst data = c === 'Skip' ? 's|' + k : 'v|' + k + '|' + c;\nreturn { json: { fromNotion: true, callback_query: { id: 'notion', data, message: { message_id: $json.cardMessageId ? Number($json.cardMessageId) : null, chat: { id: 1170608781 } } } } };",
        "mode": "runOnceForEachItem"
      }
    },
    {
      "id": "b8c423cc-3f2b-4f23-99d1-7ad954b3ec6a",
      "name": "Telegram trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        300
      ],
      "parameters": {
        "updates": [
          "callback_query",
          "message"
        ],
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram approvals"
        }
      },
      "webhookId": "95c0df0d-0d7c-48d5-9ac0-0377f0ffc365"
    },
    {
      "id": "c497f1a9-d6ff-40c4-a784-563b526e25ca",
      "name": "Parse update (rules)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "// Parse the Telegram update (rules). Only Noah's chat is accepted; everything else is ignored.\nconst u = $json; const ALLOWED = '1170608781';\nconst cb = u.callback_query; const msg = u.message;\nconst chatId = String(cb?.message?.chat?.id ?? msg?.chat?.id ?? '');\nif (chatId !== ALLOWED) return { json: { ok: false, reason: 'unauthorized chat ' + chatId } };\nif (cb) {\n  const [k, key, v] = String(cb.data || '').split('|');\n  const kind = k === 'v' ? 'choose' : k === 'e' ? 'edit' : k === 's' ? 'skip' : k === 'w' ? 'website_none' : 'unknown';\n  const id = key ? key.replace(/(.{8})(.{4})(.{4})(.{4})(.{12})/, '$1-$2-$3-$4-$5') : null;\n  return { json: { ok: kind !== 'unknown' && !!id, fromNotion: !!u.fromNotion, kind, variant: v || null, contactPageId: kind === 'website_none' ? null : id, companyPageId: kind === 'website_none' ? id : null, callbackId: cb.id, cardMessageId: cb.message?.message_id, chatId } };\n}\n// Reply to a 🌐 WEBSITE? question: the question carries 'ref w|<company key>'\nconst ref = String(msg?.reply_to_message?.text || '').match(/ref w\\|([0-9a-f]{32})/);\nif (msg && ref && msg.text) {\n  const dom = String(msg.text).trim().toLowerCase().replace(/^https?:\\/\\//, '').replace(/^www\\./, '').split(/[\\/\\s]/)[0];\n  const okDom = /^[a-z0-9-]+(\\.[a-z0-9-]+)*\\.[a-z]{2,}$/.test(dom);\n  return { json: { ok: true, kind: okDom ? 'website' : 'website_bad', domain: dom, companyPageId: ref[1].replace(/(.{8})(.{4})(.{4})(.{4})(.{12})/, '$1-$2-$3-$4-$5'), cardMessageId: msg.message_id, chatId } };\n}\nif (msg && msg.reply_to_message && msg.text) {\n  return { json: { ok: true, kind: 'reply', text: msg.text, cardMessageId: msg.reply_to_message.message_id, chatId } };\n}\nreturn { json: { ok: false, reason: 'not a button tap or a reply to a card' } };",
        "mode": "runOnceForEachItem"
      }
    },
