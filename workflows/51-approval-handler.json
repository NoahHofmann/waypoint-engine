      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        770,
        620
      ],
      "parameters": {
        "jsCode": "// Website answer from Noah -> what to write to the company.\nconst p = $json;\nif (p.kind === 'website_bad') return { json: { ...p, valid: false, notice: `\"${p.domain}\" doesn't look like a domain. Reply again with e.g. acme.ai` } };\nconst props = p.kind === 'website'\n  ? { 'Domain': { url: 'https://' + p.domain }, 'Domain source': { select: { name: 'Manual' } } }\n  : { 'Domain source': { select: { name: 'No website' } } };\nreturn { json: { ...p, valid: true, notionBody: { properties: props },\n  notice: p.kind === 'website' ? `✅ Saved ${p.domain}. Its contacts go back to email search on the next run.` : '🚫 Noted: no website. Contacts stay LinkedIn-only.' } };",
        "mode": "runOnceForEachItem"
      }
    },
