      "parameters": {
        "jsCode": "const h = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nreturn { json: { chatId: $('Parse update (rules)').item.json.chatId, replyTo: $('Parse update (rules)').item.json.replyMessageId,\n  text: '🤔 <b>Not matched to a card.</b>\\nTo answer a card: <b>swipe left on it (Reply)</b> and send your text, or tap its buttons.\\nTo give a website: reply to the 🌐 question.' } };",
