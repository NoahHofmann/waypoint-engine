      "id": "697d92ff-bc76-4cb8-a86e-11fe36458347",
      "name": "First match",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        420
      ],
      "parameters": {
        "jsCode": "// Reply path: the replied-to card identifies the contact.\nconst pg = ($json.results || [])[0];\nreturn { json: pg || { notFound: true } };",
        "mode": "runOnceForEachItem"
      }
