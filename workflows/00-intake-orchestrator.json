      ],
      "parameters": {
        "jsCode": "// Central config for the whole engine. Passed to every sub-workflow inside each item.\nreturn [{ json: {\n  maxLeadsPerRun: 15,\n  maxAgeDays: 7,\n  notionCompaniesDb: '1247998a78a8446993afa06d9811c436',\n  notionContactsDb: '349e3747aa894088a833ca4a76d6a1b2',\n  notionRunsDb: '84a655097a4449588604e918ae009c1b',\n  promptVersion: 'qualify-v1 / people-v1',\n  model: 'gpt-4o-mini',\n  eurPer1kTokens: 0.00025   // rough blended gpt-4o-mini price incl. output, for the run log\n} }];"
      }
    },
    {
      "id": "4023ea96-cd83-405c-9f0e-c6a97ac071b0",
      "name": "RSS · EU-Startups funding",
