    {
      "id": "d69d4a43-cb75-4a86-9c61-6db31b6c2364",
      "name": "Normalize + funding filter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        200
      ],
      "parameters": {
        "jsCode": "// Deterministic intake: clean, keep recent funding-like news, dedupe within batch.\nconst cfg = $('Config').first().json;\nconst cutoff = Date.now() - cfg.maxAgeDays * 864e5;\nconst FUNDING = /\\b(raises?|raised|secures?|secured|closes?|lands?|bags?|funding|seed|pre-seed|series [a-c]|investment round)\\b/i;\nconst strip = s => String(s || '').replace(/<[^>]+>/g, ' ').replace(/&[a-z#0-9]+;/gi, ' ').replace(/\\s+/g, ' ').trim();\nconst seen = new Set(); const out = [];\nfor (const it of $input.all()) {\n  const j = it.json;\n  const link = (j.link || j.guid || '').split('?')[0].replace(/\\/$/, '');\n  if (!link || seen.has(link)) continue;\n  const date = new Date(j.isoDate || j.pubDate || 0).getTime();\n  if (!date || date < cutoff) continue;\n  const title = strip(j.title);\n  const text = strip(j['content:encoded'] || j.content || j.contentSnippet || j.description).slice(0, 2500);\n  if (!FUNDING.test(title + ' ' + text.slice(0, 400))) continue;\n  seen.add(link);\n  out.push({ json: { title, link, text, published: new Date(date).toISOString().slice(0, 10),\n    source: link.includes('eu-startups') ? 'EU-Startups' : link.includes('tech.eu') ? 'Tech.eu' : 'Other' } });\n}\nreturn out;"
      }
    },
    {
      "id": "00f26a63-6b9c-427d-b02b-efa88311bdfe",
      "name": "Notion · known companies",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.notion.com/v1/databases/{{ $('Config').first().json.notionCompaniesDb }}/query",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "notionApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Notion-Version",
              "value": "2022-06-28"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"page_size\": 100, \"sorts\": [{\"timestamp\": \"created_time\", \"direction\": \"descending\"}]}",
        "options": {}
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "executeOnce": true
    },
    {
      "id": "ed3f4faa-2369-4119-9e25-4a677a55663a",
      "name": "Drop known + cap",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        200
      ],
      "parameters": {
        "jsCode": "// Idempotency across runs: skip any article already stored as a company. Cap volume for cost.\nconst cfg = $('Config').first().json;\nconst known = new Set(($input.first().json.results || [])\n  .map(p => (p.properties?.['Signal source']?.url || '').split('?')[0].replace(/\\/$/, '')).filter(Boolean));\nreturn $('Normalize + funding filter').all()\n  .filter(i => !known.has(i.json.link))\n  .slice(0, cfg.maxLeadsPerRun)\n  .map(i => ({ json: { ...i.json, cfg } }));"
      }
    },
