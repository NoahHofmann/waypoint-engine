    {
      "id": "65abd71f-6bca-45ee-b30e-3708fd9893ab",
      "name": "Build run log",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1800,
        340
      ],
      "parameters": {
        "jsCode": "// One row per run in Notion › Runs.\nconst cfg = $('Config').first().json;\nconst r = $input.all().map(i => i.json);\nconst signals = $('Normalize + funding filter').all().length;\nconst tokens = r.reduce((a, x) => a + (x.tokensEst || 0), 0);\nconst created = r.filter(x => x.ok).length;\nconst errors = r.filter(x => !x.ok || x.error).length;\nconst n = s => r.filter(x => x.status === s).length;\nconst injected = r.filter(x => (x.flags || []).includes('Injection pattern')).length;\nconst t = s => [{ type: 'text', text: { content: String(s).slice(0, 1900) } }];\nreturn [{ json: { parent: { database_id: cfg.notionRunsDb }, properties: {\n  'Run': { title: t(`Intake ${new Date().toISOString().slice(0,16).replace('T',' ')}`) },\n  'Workflow': { select: { name: 'Intake' } },\n  'Status': { select: { name: errors === 0 ? 'Success' : created > 0 ? 'Partial' : 'Failed' } },\n  'Started': { date: { start: new Date().toISOString() } },\n  'Execution ID': { rich_text: t($execution.id) },\n  'Items in': { number: signals },\n  'Items out': { number: created },\n  'Duplicates skipped': { number: signals - r.length },\n  'Errors': { number: errors },\n  'Tokens': { number: tokens },\n  'Cost EUR': { number: Math.round(tokens / 1000 * cfg.eurPer1kTokens * 10000) / 10000 },\n  'Notes': { rich_text: t(`${n('Qualified')} qualified, ${n('Archived')} archived, ${n('Rejected')} rejected (${injected} injection). Tokens estimated. ${cfg.model}, ${cfg.promptVersion}.`) }\n}}}];"
      }
    },
